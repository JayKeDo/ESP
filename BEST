local destroyed = false
local connections = {}

local function connect(signal, fn)
    local c = signal:Connect(fn)
    connections[#connections + 1] = c
    return c
end

local function safeDestroy(obj)
    if obj then
        pcall(function() obj:Destroy() end)
    end
end

local function New(className, props, parent)
    local ok, obj = pcall(Instance.new, className)
    if not ok or not obj then return nil end
    for k, v in pairs(props or {}) do
        local assigned, reason = pcall(function() obj[k] = v end)
        if not assigned then
            obj:Destroy()
            error("[Advanced ESP] " .. className .. "." .. k .. ": " .. tostring(reason), 2)
        end
    end
    if parent then
        local parentOk = pcall(function() obj.Parent = parent end)
        if not parentOk or obj.Parent ~= parent then
            pcall(function() obj:Destroy() end)
            return nil
        end
    end
    return obj
end

local function clamp01(v)
    return math.clamp(tonumber(v) or 0, 0, 1)
end

local function lerpColor(a, b, t)
    t = clamp01(t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

local function hsvToColor(h, s, v)
    h = (tonumber(h) or 0) % 360
    s = clamp01(s)
    v = clamp01(v)

    local c = v * s
    local hp = h / 60
    local x = c * (1 - math.abs((hp % 2) - 1))
    local r, g, b = 0, 0, 0

    if hp < 1 then
        r, g, b = c, x, 0
    elseif hp < 2 then
        r, g, b = x, c, 0
    elseif hp < 3 then
        r, g, b = 0, c, x
    elseif hp < 4 then
        r, g, b = 0, x, c
    elseif hp < 5 then
        r, g, b = x, 0, c
    else
        r, g, b = c, 0, x
    end

    local m = v - c
    return Color3.new(r + m, g + m, b + m)
end

local function colorToHSV(c)
    c = c or Color3.new(1, 1, 1)
    local r, g, b = c.R, c.G, c.B
    local mx = math.max(r, g, b)
    local mn = math.min(r, g, b)
    local d = mx - mn

    local h = 0
    if d ~= 0 then
        if mx == r then
            h = ((g - b) / d) % 6
        elseif mx == g then
            h = ((b - r) / d) + 2
        else
            h = ((r - g) / d) + 4
        end
        h = h * 60
    end

    local s = mx == 0 and 0 or d / mx
    return h, s, mx
end

local function healthColor(hp, maxHp)
    maxHp = math.max(tonumber(maxHp) or 100, 1)
    local t = clamp01((tonumber(hp) or 0) / maxHp)
    if t > 0.5 then
        return lerpColor(Color3.fromRGB(70, 235, 95), Color3.fromRGB(255, 175, 45), (1 - t) * 2)
    end
    return lerpColor(Color3.fromRGB(255, 175, 45), Color3.fromRGB(255, 55, 70), (0.5 - t) * 2)
end

local function measureText(text, size)
    local ok, result = pcall(function()
        return TextService:GetTextSize(tostring(text), size, Enum.Font.Gotham, Vector2.new(1200, 500))
    end)
    return ok and result or Vector2.new(size * #tostring(text) * 0.55, size)
end

