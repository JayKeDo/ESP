local function part(char, name)
    local p=char and char:FindFirstChild(name)
    return p and p:IsA("BasePart") and p or nil
end
local function rootOf(char)
    if not char then return nil end
    return part(char,"HumanoidRootPart") or part(char,"Torso") or part(char,"UpperTorso") or char.PrimaryPart
end
local function teammate(p)
    if not p then return false end
    if not p.Neutral and not LP.Neutral and p.Team and LP.Team then return p.Team==LP.Team end
    local a=p:GetAttribute("Team") or (p.Character and p.Character:GetAttribute("Team"))
    local b=LP:GetAttribute("Team") or (LP.Character and LP.Character:GetAttribute("Team"))
    if a~=nil and b~=nil then return a==b end
    local function faction(player)
        local stats=player:FindFirstChild("leaderstats")
        if stats then
            for _,name in ipairs({"Team","TeamName","Faction"}) do
                local v=stats:FindFirstChild(name)
                if v and (v:IsA("StringValue") or v:IsA("IntValue") or v:IsA("NumberValue")) then return v.Value end
            end
        end
    end
    a,b=faction(p),faction(LP)
    return a~=nil and b~=nil and a==b
end
local function attach(key, player)
    if targets[key] then return end
    targets[key]={player=player, model=not player and key or nil, refreshAt=0, occAt=0, bones={}}
end
local function candidate(obj)
    if obj:IsA("Humanoid") then candidates[obj]=true end
end
