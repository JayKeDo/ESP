local function syncNpcs()
    for key,t in pairs(targets) do
        if not t.player and (not ES.NpcEsp or not key:IsDescendantOf(Workspace)
            or not key:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(key)) then remove(key) end
    end
    if not ES.NpcEsp then return end
    for hum in pairs(candidates) do
        local model=hum.Parent
        if not model or not hum:IsDescendantOf(Workspace) then candidates[hum]=nil
        elseif model:IsA("Model") and model~=LP.Character and not Players:GetPlayerFromCharacter(model)
            and not (LP.Character and model:IsDescendantOf(LP.Character)) then attach(model,nil) end
    end
end

local function refreshCharacter(t, now)
    local char=t.player and t.player.Character or t.model
    if char~=t.char then
        hide(t); safeDestroy(t.cham); t.cham=nil
        t.char=char; t.root=nil; t.hum=nil; t.bones={}; t.refreshAt=0; t.occAt=0
    end
    if not char or not char:IsDescendantOf(Workspace) then return false end
    if now>=t.refreshAt or not t.root or not t.root.Parent or not t.hum or not t.hum.Parent then
        t.refreshAt=now+0.25
        t.root=rootOf(char); t.hum=char:FindFirstChildOfClass("Humanoid")
        t.bones={}
        for _,pair in ipairs(BONES) do
            local a,b=part(char,pair[1]),part(char,pair[2])
            if a and b then t.bones[#t.bones+1]={a,b} end
        end
        t.name=t.player and t.player.Name or char.Name
        t.display=t.player and t.player.DisplayName or char.Name
        t.team=teammate(t.player)
        local tool=char:FindFirstChildOfClass("Tool")
        t.tool=tool and tool.Name or ""
        -- Bounds include body parts only; oversized accessories/tools do not inflate boxes.
        if t.root then
            local low,high=Vector3.new(math.huge,math.huge,math.huge),Vector3.new(-math.huge,-math.huge,-math.huge)
            local found=false
            for _,body in ipairs(char:GetChildren()) do
                if body:IsA("BasePart") and body.Name~="HumanoidRootPart" then
                    for _,sign in ipairs(SIGNS) do
                        local p=t.root.CFrame:PointToObjectSpace(body.CFrame:PointToWorldSpace(
                            Vector3.new(sign[1]*body.Size.X/2,sign[2]*body.Size.Y/2,sign[3]*body.Size.Z/2)))
                        low=Vector3.new(math.min(low.X,p.X),math.min(low.Y,p.Y),math.min(low.Z,p.Z))
                        high=Vector3.new(math.max(high.X,p.X),math.max(high.Y,p.Y),math.max(high.Z,p.Z))
                        found=true
                    end
                end
            end
            t.offset=found and (low+high)/2 or Vector3.new(0,0,0)
            t.size=found and high-low or Vector3.new(4,6,2)
        end
    end
    return t.root~=nil and t.hum~=nil and t.hum.Health>0
end
local function createDraw(t)
    t.container=New("Frame",{Name="Target_"..t.name,Size=UDim2.fromScale(1,1),
        BackgroundTransparency=1,BorderSizePixel=0,Visible=false,ClipsDescendants=true},overlay)
    if not t.container then error("Could not allocate target overlay") end
    t.draw={}
end
local function visual(t,key,kind)
    local o=t.draw[key]
    if o then return o end
    if kind=="text" then
        o=New("TextLabel",{BackgroundTransparency=1,BorderSizePixel=0,Text="",RichText=false,
            Font=Enum.Font.GothamMedium,TextSize=13,TextColor3=Theme.text,TextStrokeColor3=Color3.new(0,0,0),
            TextStrokeTransparency=0.25,AnchorPoint=Vector2.new(0.5,1),ZIndex=5,Visible=false},t.container)
    else
        o=New("Frame",{BackgroundColor3=Theme.text,BorderSizePixel=0,AnchorPoint=Vector2.new(0.5,0.5),
            ZIndex=kind=="fill" and 1 or 3,Visible=false},t.container)
        if kind=="dot" then New("UICorner",{CornerRadius=UDim.new(1,0)},o) end
    end
    if not o then error("Could not allocate "..key) end
    t.draw[key]=o
    return o
end
-- Liang-Barsky clipping avoids huge GUI line lengths near/behind the camera.
local function clip2(a,b,vp)
    local dx,dy=b.X-a.X,b.Y-a.Y
    local lo,hi=0,1
    local function bound(p,q)
        if math.abs(p)<1e-8 then return q>=0 end
        local r=q/p
        if p<0 then if r>hi then return false end; lo=math.max(lo,r)
        else if r<lo then return false end; hi=math.min(hi,r) end
        return true
    end
    if not bound(-dx,a.X) or not bound(dx,vp.X-a.X) or not bound(-dy,a.Y) or not bound(dy,vp.Y-a.Y) then return end
    return Vector2.new(a.X+lo*dx,a.Y+lo*dy),Vector2.new(a.X+hi*dx,a.Y+hi*dy)
end
local function line(t,key,a,b,color,width,opacity)
    a,b=clip2(a,b,camera.ViewportSize)
    if not a then return end
    local delta=b-a
    if delta.Magnitude<0.5 then return end
    local o=visual(t,key,"line")
    o.Position=UDim2.fromOffset((a.X+b.X)/2,(a.Y+b.Y)/2)
    o.Size=UDim2.fromOffset(delta.Magnitude,math.max(1,width))
    o.Rotation=math.deg(math.atan2(delta.Y,delta.X))
    o.BackgroundColor3=color; o.BackgroundTransparency=1-clamp01(opacity); o.Visible=true
end
local function project(p)
    local v=camera:WorldToViewportPoint(p)
    return Vector2.new(v.X,v.Y),v.Z
end
local function segment(a,b)
    local ca,cb=camera.CFrame:PointToObjectSpace(a),camera.CFrame:PointToObjectSpace(b)
    local da,db=-ca.Z,-cb.Z
    local near=0.1
    if da<near and db<near then return end
    if da<near then a=a+(b-a)*((near-da)/(db-da))
    elseif db<near then b=a+(b-a)*((near-da)/(db-da)) end
    return project(a),project(b)
end
local ray=RaycastParams.new()
ray.FilterType=Enum.RaycastFilterType.Exclude
local function occluded(t)
    local ignored={t.char}
    if LP.Character then ignored[#ignored+1]=LP.Character end
    ray.FilterDescendantsInstances=ignored
    local head=part(t.char,"Head") or t.root
    local origin=camera.CFrame.Position
    return Workspace:Raycast(origin,head.Position-origin,ray)~=nil
end
local function color(t,key,hp,maxHp)
    if ES.Rainbow and (ES.RainbowScope=="All ESP" or colorEffects.target=="all") then return colorEffects.color end
    if not t.player then key="npc" elseif t.team and ES.TeamColors then key="team" end
    if ES.Rainbow and key==colorEffects.target then return displayColor(key) end
    if ES.HealthColor then return healthColor(hp,maxHp) end
    return displayColor(key)
end
local function chams(t,col,opacity)
    if not ES.Chams then safeDestroy(t.cham); t.cham=nil; return end
    if t.chamUnavailable then return end
    if not t.cham or not t.cham.Parent then
        local ok,result=pcall(New,"Highlight",{Name="SpectraHighlight",Adornee=t.char,Enabled=false},t.char)
        if not ok or not result then
            t.chamUnavailable=true
            report("Highlight unavailable; other ESP features remain active: "..tostring(result))
            return
        end
        t.cham=result
    end
    local h=t.cham
    h.Adornee=t.char; h.FillColor=col; h.OutlineColor=col
    h.DepthMode=ES.VisMode=="VisibleOnly" and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
    h.FillTransparency=1-clamp01(ES.ChamAlpha*opacity*(ES.ChamStyle=="Glow" and 0.35 or 1))
    h.OutlineTransparency=ES.ChamStyle=="Tint" and 1 or 1-opacity
    h.Enabled=true
end
local function arrow(t,world,col,opacity)
    if not ES.Offscreen then return end
    local v=camera.CFrame:PointToObjectSpace(world)
    local dir=Vector2.new(v.X,-v.Y)
    if dir.Magnitude<0.001 then dir=Vector2.new(0,1) end
    dir=dir.Unit
    local vp=camera.ViewportSize
    local center=vp/2
    local radius=math.min(math.max(1,center.X-30)/math.max(math.abs(dir.X),0.001),
        math.max(1,center.Y-30)/math.max(math.abs(dir.Y),0.001))
    local tip=center+dir*radius
    local normal=Vector2.new(-dir.Y,dir.X)
    line(t,"arrow1",tip,tip-dir*13+normal*7,col,3,opacity)
    line(t,"arrow2",tip,tip-dir*13-normal*7,col,3,opacity)
    line(t,"arrow3",tip-dir*13+normal*7,tip-dir*13-normal*7,col,2,opacity)
end
local function update(t,now)
    hide(t)
    if not ES.Chams and t.cham then safeDestroy(t.cham); t.cham=nil end
    if not ES.Enabled or not camera or not refreshCharacter(t,now) then return end
    if not t.player and not ES.NpcEsp then return end
    if t.team and not ES.ShowTeammates then return end
    local distance=(camera.CFrame.Position-t.root.Position).Magnitude
    local range=t.player and ES.MaxDist or math.min(ES.NpcRange,ES.MaxDist)
    if distance>range then return end
    if ES.VisMode~="Always" then
        if now>=t.occAt then t.occAt=now+ES.OcclusionRefresh; t.occluded=occluded(t) end
        if (ES.VisMode=="VisibleOnly" and t.occluded) or (ES.VisMode=="HiddenOnly" and not t.occluded) then return end
    end
    if not t.draw then createDraw(t) end
    for _,o in pairs(t.draw) do o.Visible=false end
    t.container.Visible=true
    local hp,maxHp=t.hum.Health,math.max(t.hum.MaxHealth,1)
    local opacity=ES.DistanceFade and math.max(0.2,1-distance/math.max(range,1)*0.8) or 1
    chams(t,color(t,"cham",hp,maxHp),opacity)
    local cf=t.root.CFrame*CFrame.new(t.offset)
    local half=t.size*ES.BoxSize/2
    local world={}
    for i,sign in ipairs(SIGNS) do world[i]=cf:PointToWorldSpace(Vector3.new(sign[1]*half.X,sign[2]*half.Y,sign[3]*half.Z)) end
    local xmin,ymin,xmax,ymax=math.huge,math.huge,-math.huge,-math.huge
    local projected={}
    for i,edge in ipairs(EDGES) do
        local a,b=segment(world[edge[1]],world[edge[2]])
        if a then
            projected[i]={a,b}
            xmin=math.min(xmin,a.X,b.X); ymin=math.min(ymin,a.Y,b.Y)
            xmax=math.max(xmax,a.X,b.X); ymax=math.max(ymax,a.Y,b.Y)
        end
    end
    local vp=camera.ViewportSize
    if xmin==math.huge or xmax<0 or xmin>vp.X or ymax<0 or ymin>vp.Y then
        arrow(t,cf.Position,color(t,"offscreen",hp,maxHp),opacity)
        return
    end
    diagnostics.Visible=diagnostics.Visible+1
    local x,y=math.clamp(xmin,0,vp.X),math.clamp(ymin,0,vp.Y)
    local w,h=math.clamp(xmax,0,vp.X)-x,math.clamp(ymax,0,vp.Y)-y
    local th=ES.BoxW
    if ES.Box then
        local col=color(t,"box",hp,maxHp)
        line(t,"box1",Vector2.new(x,y),Vector2.new(x+w,y),col,th,opacity)
        line(t,"box2",Vector2.new(x+w,y),Vector2.new(x+w,y+h),col,th,opacity)
        line(t,"box3",Vector2.new(x+w,y+h),Vector2.new(x,y+h),col,th,opacity)
        line(t,"box4",Vector2.new(x,y+h),Vector2.new(x,y),col,th,opacity)
    end
    if ES.BoxFill then
        local o=visual(t,"fill","fill")
        o.Position=UDim2.fromOffset(x+w/2,y+h/2); o.Size=UDim2.fromOffset(w,h)
        o.BackgroundColor3=color(t,"boxfill",hp,maxHp)
        o.BackgroundTransparency=1-(1-clamp01(ES.FillAlpha))*opacity; o.Visible=true
    end
    if ES.Box3D then
        for i,pair in pairs(projected) do line(t,"3d"..i,pair[1],pair[2],color(t,"box3d",hp,maxHp),th,opacity) end
    end
    if ES.Tracer then
        local head=part(t.char,"Head") or t.root
        local p,z=project(head.Position)
        local origin=Vector2.new(vp.X/2,ES.TracerMode=="Top" and 3 or ES.TracerMode=="Bottom" and vp.Y-3 or vp.Y/2)
        if z>0.1 then line(t,"tracer",origin,p,color(t,"tracer",hp,maxHp),math.max(1,th-1),opacity) end
    end
    if ES.Skeleton then
        for i,bone in ipairs(t.bones) do
            if bone[1].Parent and bone[2].Parent then
                local a,b=segment(bone[1].Position,bone[2].Position)
                if a then line(t,"bone"..i,a,b,color(t,"skeleton",hp,maxHp),math.max(1,th-1),opacity) end
            end
        end
    end
    if ES.HeadDot then
        local head=part(t.char,"Head")
        if head then
            local p,z=project(head.Position)
            if z>0.1 then
                local o=visual(t,"head","dot")
                o.Position=UDim2.fromOffset(p.X,p.Y); o.Size=UDim2.fromOffset(8,8)
                o.BackgroundColor3=color(t,"head",hp,maxHp); o.BackgroundTransparency=1-opacity; o.Visible=true
            end
        end
    end
    local labels={}
    if ES.ShowName then labels[#labels+1]=(t.player and "" or "[NPC] ")..t.name end
    if ES.ShowDisplayName and (not ES.ShowName or t.display~=t.name) then labels[#labels+1]=t.display end
    if ES.ShowID and t.player then labels[#labels+1]="ID "..tostring(t.player.UserId) end
    if ES.ShowDist then labels[#labels+1]=string.format("%d studs",math.floor(distance+0.5)) end
    if ES.ShowHealthText then labels[#labels+1]=string.format("%d / %d HP",math.floor(hp),math.floor(maxHp)) end
    if ES.ShowTool and t.tool~="" then labels[#labels+1]=t.tool end
    if ES.ShowVelocity then labels[#labels+1]=string.format("%d studs/s",math.floor(t.root.AssemblyLinearVelocity.Magnitude+0.5)) end
    if #labels>0 then
        local o=visual(t,"label","text")
        local height=#labels*(ES.FontSize+3)
        o.Text=table.concat(labels,"\n"); o.TextSize=ES.FontSize; o.TextColor3=color(t,"name",hp,maxHp)
        o.TextTransparency=1-opacity; o.TextStrokeTransparency=1-opacity*0.8
        o.Size=UDim2.fromOffset(math.min(vp.X,math.max(220,w+80)),height)
        o.Position=UDim2.fromOffset(math.clamp(x+w/2,110,math.max(110,vp.X-110)), math.max(height+3,y-7))
        o.Visible=true
    end
    if ES.ShowHealthBar then
        local pct=clamp01(hp/maxHp)
        local a,b,finish
        if ES.HBarDir=="Vertical" then
            a=Vector2.new(x+w+5,y+h); b=Vector2.new(x+w+5,y); finish=a+(b-a)*pct
        else
            local width=math.clamp(w,30,180)
            a=Vector2.new(x+(w-width)/2,y+h+5); b=a+Vector2.new(width,0); finish=a+(b-a)*pct
        end
        line(t,"healthBack",a,b,Color3.fromRGB(12,16,22),5,opacity)
        line(t,"health",a,finish,color(t,"health",hp,maxHp),3,opacity)
    end
end

local elapsed,npcElapsed,hudElapsed,frames,frameTime=0,0,0,0,0
local lastViewport=Vector2.new(0,0)
local function render(dt)
    if destroyed then return end
    camera=Workspace.CurrentCamera
    elapsed=elapsed+dt; npcElapsed=npcElapsed+dt; hudElapsed=hudElapsed+dt
    frames=frames+1; frameTime=frameTime+dt
    if camera and camera.ViewportSize~=lastViewport then lastViewport=camera.ViewportSize; fitPanel() end
    if npcElapsed>=ES.NpcRefresh then npcElapsed=0; syncNpcs() end
    crosshair.Visible=ES.Crosshair
    fpsLabel.Visible=ES.FPS
    if elapsed>=ES.UpdateRate then
        elapsed=elapsed%ES.UpdateRate
        diagnostics.Updates=diagnostics.Updates+1; diagnostics.Visible=0
        local now=os.clock()
        for key,t in pairs(targets) do
            if (t.player and not t.player.Parent) or (t.model and not t.model.Parent) then remove(key)
            else
                local ok,err=pcall(update,t,now)
                if not ok then hide(t); report(err) end
            end
        end
    end
    if hudElapsed>=0.5 then
        hudElapsed=0
        local pc,nc=0,0
        for _,t in pairs(targets) do if t.player then pc=pc+1 else nc=nc+1 end end
        fpsLabel.Text=string.format("%d FPS",math.floor(frames/math.max(frameTime,0.001)+0.5))
        frames,frameTime=0,0
        statLabel.Text=string.format("%d PLAYERS  /  %d NPCs  /  %d IN VIEW  /  %d STUDS",pc,nc,diagnostics.Visible,ES.MaxDist)
        statusText.Text=not ES.Enabled and "PAUSED" or diagnostics.Errors>0 and "CHECK LOG" or "LIVE"
        statusText.TextColor3=ES.Enabled and Theme.good or Theme.muted
        statusDot.BackgroundColor3=statusText.TextColor3
    end
end
-- Camera-priority binding keeps projected labels synchronized with camera movement.
local renderName="SpectraESP_"..tostring(Screen)
local bound,bindError=pcall(function()
    RunService:BindToRenderStep(renderName,Enum.RenderPriority.Camera.Value+1,function(dt)
        local ok,err=pcall(render,dt)
        if not ok then for _,t in pairs(targets) do hide(t) end; report(err) end
    end)
end)
if bound then
    connections[#connections+1]={Disconnect=function() RunService:UnbindFromRenderStep(renderName) end}
else
    warn("[Advanced ESP] Using RenderStepped fallback: "..tostring(bindError))
    connect(RunService.RenderStepped,function(dt)
        local ok,err=pcall(render,dt)
        if not ok then for _,t in pairs(targets) do hide(t) end; report(err) end
    end)
end
