local pointerInput, pointerMove
local function pointerPosition(input)
    if input.UserInputType==Enum.UserInputType.Touch then return Vector2.new(input.Position.X,input.Position.Y) end
    return UIS:GetMouseLocation()
end
local function bindPointer(obj, moved)
    obj.Active=true
    connect(obj.InputBegan,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            pointerInput=input; pointerMove=moved
            moved(pointerPosition(input),true)
        end
    end)
end
connect(UIS.InputChanged,function(input)
    if pointerMove and (input==pointerInput or input.UserInputType==Enum.UserInputType.MouseMovement) then
        pointerMove(pointerPosition(input),false)
    end
end)
connect(UIS.InputEnded,function(input)
    if input==pointerInput or input.UserInputType==Enum.UserInputType.MouseButton1 then pointerInput=nil; pointerMove=nil end
end)
connect(UIS.WindowFocusReleased,function() pointerInput=nil; pointerMove=nil end)
bindPointer(Header,function(pos,start)
    if start then dragStart=pos; panelStart=Panel.Position end
    local delta=pos-dragStart
    Panel.Position=UDim2.fromOffset(panelStart.X.Offset+delta.X,panelStart.Y.Offset+delta.Y)
    fitPanel()
end)

