    local function refresh()
        local v=math.clamp(tonumber(getter()) or min,min,max)
        fill.BackgroundColor3=displayColor("accent")
        fill.Size=UDim2.fromScale((v-min)/math.max(max-min,0.000001),1)
        valueLabel.Text=formatter and formatter(v) or tostring(math.floor(v+0.5))
    end
    bindPointer(bar,function(pos)
        local pct=math.clamp((pos.X-bar.AbsolutePosition.X)/math.max(bar.AbsoluteSize.X,1),0,1)
        setter(min+(max-min)*pct)
        refresh()
    end)

    refreshControls[#refreshControls+1] = refresh
    refresh()
    return row
end

