local function applyRingFromPosition(pos)
    if not hueRing then return end
    local size=hueRing.AbsoluteSize.X
    local cx=hueRing.AbsolutePosition.X+size/2; local cy=hueRing.AbsolutePosition.Y+size/2
    local dx,dy=pos.X-cx,pos.Y-cy
    if dx*dx+dy*dy < 36*36 then return end
    local a=math.atan2(dy,dx)+math.pi/2
    if a<0 then a=a+math.pi*2 end
    hue=(a/(math.pi*2))*360
    refreshPicker()
end
