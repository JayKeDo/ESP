-- Named local slots. Only plain JSON is read; configurations are never executed.
do
    local Http=game:GetService("HttpService")
    local defaults,defaultColors={},{}
    for k,v in pairs(ES) do defaults[k]=v end
    for k,v in pairs(CColor) do defaultColors[k]=v end
    local memory=environment.SpectraSavedPresets
    if type(memory)~="table" then memory={}; environment.SpectraSavedPresets=memory end
    local slot="Slot 1"
    local write=type(writefile)=="function" and writefile or environment.writefile
    local read=type(readfile)=="function" and readfile or environment.readfile
    local persistent=type(write)=="function" and type(read)=="function"
    local saveBody=addSection(Settings,"Saved presets")
    local message=New("TextLabel",{Size=UDim2.new(1,0,0,40),BackgroundTransparency=1,TextWrapped=true,
        Text=persistent and "LOCAL STORAGE / Save settings and colors to one of three slots." or "SESSION STORAGE / File APIs unavailable. Slots survive script reruns in this session.",
        Font=Enum.Font.Gotham,TextSize=11,TextColor3=Theme.muted,ZIndex=24},saveBody)
    addCycle(saveBody,"Preset Slot",{"Slot 1","Slot 2","Slot 3"},function() return slot end,function(v) slot=v end)
    local function status(text,failed) message.Text=text; message.TextColor3=failed and PRESETS.Red or Theme.good end
    local function path() return "SpectraESP_Preset_"..slot:sub(-1)..".json" end
    local ranges={MaxDist={100,10000},NpcRange={50,2500},BoxW={1,6},BoxSize={0.5,1.5},FontSize={10,22},
        ChamAlpha={0.05,1},FillAlpha={0.05,1},UpdateRate={1/60,1/20},NpcRefresh={0.25,2},
        OcclusionRefresh={0.05,0.5},UIAlpha={0,0.35},UIScale={0.75,1.25},RainbowSpeed={0.02,0.5}}
    local choices={VisMode={Always=true,VisibleOnly=true,HiddenOnly=true},HBarDir={Horizontal=true,Vertical=true},
        TracerMode={Top=true,Bottom=true,Center=true},ChamStyle={Glow=true,Tint=true},
        RainbowScope={["All ESP"]=true,["Selected Target"]=true}}
    local keys={RightShift=Enum.KeyCode.RightShift,Insert=Enum.KeyCode.Insert,Home=Enum.KeyCode.Home,F4=Enum.KeyCode.F4}
    local function snapshot()
        local data={Version=1,Settings={},Colors={},ColorTarget=currentTargetKey()}
        for k,v in pairs(ES) do data.Settings[k]=k=="MenuKey" and v.Name or v end
        for k,c in pairs(CColor) do data.Colors[k]={c.R,c.G,c.B} end
        return data
    end
    local function apply(data)
        if type(data)~="table" or data.Version~=1 or type(data.Settings)~="table" or type(data.Colors)~="table" then error("Not a supported Spectra preset") end
        local settings,colors={},{}
        -- Validate the entire document before touching live state.
        for k,default in pairs(defaults) do
            local v=data.Settings[k]
            if v==nil then v=default
            elseif k=="MenuKey" then v=keys[v]; if not v then error("Invalid menu key") end
            elseif type(v)~=type(default) then error("Invalid setting: "..k)
            elseif type(v)=="number" then
                if v~=v or v==math.huge or v==-math.huge then error("Invalid number") end
                if ranges[k] then v=math.clamp(v,ranges[k][1],ranges[k][2]) end
            elseif choices[k] and not choices[k][v] then error("Invalid option: "..k) end
            settings[k]=v
        end
        for k,default in pairs(defaultColors) do
            local v=data.Colors[k]
            if v==nil then colors[k]=default
            else
                if type(v)~="table" then error("Invalid color") end
                for i=1,3 do if type(v[i])~="number" or v[i]~=v[i] or v[i]<0 or v[i]>1 then error("Invalid color channel") end end
                colors[k]=Color3.new(v[1],v[2],v[3])
            end
        end
        for k,v in pairs(settings) do ES[k]=v end
        for k,v in pairs(colors) do CColor[k]=v end
        for i,info in ipairs(ColorTargets) do if info[1]==data.ColorTarget then targetIndex=i end end
        hue,sat,val=colorToHSV(CColor[currentTargetKey()])
        Panel.BackgroundTransparency=ES.UIAlpha
        fitPanel(); refreshPicker(true); setAccent()
        for _,refresh in ipairs(refreshControls) do refresh() end
    end
    local function action(label,callback)
        local button=New("TextButton",{Size=UDim2.new(1,0,0,36),Text=label,Font=Enum.Font.GothamBold,
            TextSize=11,TextColor3=Theme.text,BackgroundColor3=Theme.slot,BorderSizePixel=0,ZIndex=25},saveBody)
        New("UICorner",{CornerRadius=UDim.new(0,8)},button)
        connect(button.Activated,callback)
    end
    action("SAVE TO SELECTED SLOT",function()
        local ok,result=pcall(function() return Http:JSONEncode(snapshot()) end)
        if not ok then status("Save failed: "..tostring(result),true); return end
        memory[slot]=result
        if persistent then
            local wrote,err=pcall(write,path(),result)
            if not wrote then status("Kept in session; disk save failed: "..tostring(err),true); return end
        end
        status(slot..(persistent and " saved to local storage." or " saved for this session."))
    end)
    action("LOAD SELECTED SLOT",function()
        local raw=memory[slot]
        if raw==nil and persistent then local ok,result=pcall(read,path()); if ok then raw=result end end
        if type(raw)~="string" then status("No saved preset in "..slot..".",true); return end
        if #raw>100000 then status("Preset exceeds size limit.",true); return end
        local ok,err=pcall(function() apply(Http:JSONDecode(raw)) end)
        status(ok and (slot.." loaded.") or ("Load failed: "..tostring(err)),not ok)
    end)
    action("RESTORE DEFAULT SETTINGS",function()
        local data={Version=1,Settings={},Colors={},ColorTarget="all"}
        for k,v in pairs(defaults) do data.Settings[k]=k=="MenuKey" and v.Name or v end
        for k,c in pairs(defaultColors) do data.Colors[k]={c.R,c.G,c.B} end
        local ok,err=pcall(apply,data)
        status(ok and "Defaults restored. Saved slots are unchanged." or tostring(err),not ok)
    end)
end

