--// One shared color editor. Pick an ESP target, then edit Hue / Saturation / Value.
--// The picker uses input positions directly instead of GetMouseLocation so the
--// cursor stays synchronized even when the menu is inside CoreGui/PlayerGui.
local targetIndex = 1
local hue, sat, val = colorToHSV(CColor[ColorTargets[targetIndex][1]])
local targetButton, preview, hexLabel, rgbLabel, hsvLabel, targetDesc
local hueRing, svSquare, hueRail, hueThumb, svCursor, ringDot
local targetDropdown, randomButton, copyButton
local dropdownOpen = false
local studioRows = {}

local function currentTargetKey()
    return ColorTargets[targetIndex][1]
end

local function currentColor()
    return hsvToColor(hue, sat, val)
end

local function colorHex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R*255+.5), math.floor(c.G*255+.5), math.floor(c.B*255+.5))
end

local function colorRGB(c)
    return string.format("RGB  %d  /  %d  /  %d", math.floor(c.R*255+.5), math.floor(c.G*255+.5), math.floor(c.B*255+.5))
end

local function colorHSVText()
    return string.format("HSV  %03d°  /  %03d%%  /  %03d%%", math.floor(hue+.5), math.floor(sat*100+.5), math.floor(val*100+.5))
end

local function setAccent()
    for _, binding in ipairs(accentBindings) do
        if binding[1].Parent then binding[1][binding[2]] = displayColor("accent") end
    end
    for _, refresh in ipairs(refreshControls) do refresh() end
    panelStroke.Color = displayColor("accent")
    accentBar.BackgroundColor3 = displayColor("accent")
    for i,t in ipairs(tabs) do
        t.BackgroundColor3 = i == activePage and displayColor("accent") or Theme.slot
    end
    for _,pg in ipairs(pages) do
        pg.ScrollBarImageColor3 = displayColor("accent")
    end
end

local function setGradientHue(frame, h)
    if frame then
        frame.BackgroundColor3 = hsvToColor(h, 1, 1)
    end
end

local function positionSVCursor()
    if not svCursor or not svSquare then return end
    local w = math.max(svSquare.AbsoluteSize.X, 1)
    local h = math.max(svSquare.AbsoluteSize.Y, 1)
    svCursor.AnchorPoint = Vector2.new(0.5, 0.5)
    svCursor.Position = UDim2.fromScale(sat, 1-val)
    svCursor.BackgroundColor3 = currentColor()
end

local function positionHueThumb()
    if not hueThumb or not hueRail then return end
    local h = math.max(hueRail.AbsoluteSize.Y, 1)
    hueThumb.AnchorPoint = Vector2.new(0.5, 0.5)
    hueThumb.Position = UDim2.fromScale(0.5, hue/360)
    hueThumb.BackgroundColor3 = currentColor()
end

local function positionRingDot()
    if not ringDot or not hueRing then return end
    local size = hueRing.AbsoluteSize.X
    local cx, cy = size/2, size/2
    local radius = math.min(size,size)/2 - 22
    local a = math.rad(hue - 90)
    ringDot.AnchorPoint = Vector2.new(0.5, 0.5)
    ringDot.Position = UDim2.fromScale(0.5 + math.cos(a)*67/172, 0.5 + math.sin(a)*67/172)
    ringDot.BackgroundColor3 = currentColor()
end

local function refreshPicker(selectOnly)
    local c = currentColor()
    CColor[currentTargetKey()] = c
    colorEffects.target=currentTargetKey()
    if currentTargetKey()=="all" and not selectOnly then
        for key in pairs(CColor) do if key~="accent" or ES.ColorAllUI then CColor[key]=c end end
    end

    if preview then
        preview.BackgroundColor3 = c
    end
    if hexLabel then hexLabel.Text = colorHex(c) end
    if rgbLabel then rgbLabel.Text = colorRGB(c) end
    if hsvLabel then hsvLabel.Text = colorHSVText() end
    if targetButton then targetButton.Text = ColorTargets[targetIndex][2] end
    if targetDesc then targetDesc.Text = ColorTargets[targetIndex][3] end

    if svSquare then
        setGradientHue(svSquare, hue)
    end
    positionSVCursor()
    positionHueThumb()
    positionRingDot()

    if targetDropdown then
        for _,ch in ipairs(targetDropdown:GetChildren()) do
            if ch:IsA("TextButton") then
                local n = tonumber(ch.Name:match("^Target(%d+)$"))
                if n then
                    ch.BackgroundColor3 = n == targetIndex and CColor.accent or Theme.slot
                    ch.TextColor3 = n == targetIndex and Color3.new(1,1,1) or Theme.text
                end
            end
        end
    end

    if currentTargetKey() == "accent" or currentTargetKey()=="all" then setAccent() end
end

